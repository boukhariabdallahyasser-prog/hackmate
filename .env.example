# Local development and isolated preview configuration.
# Copy to .env.local and replace placeholders with values from your
# isolated Supabase preview project. Never use a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PREVIEW-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PREVIEW_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel automatically provides VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL.
# On Vercel Production set these three public values to the approved project.
